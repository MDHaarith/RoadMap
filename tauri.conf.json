{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadmap",
  "version": "0.2.0",
  "identifier": "app.roadmap.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roadmap",
        "width": 1400,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' https: data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Learn anything by doing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "yt-dlp",
          "bubblewrap",
          "bash",
          "ca-certificates"
        ],
        "desktopTemplate": "roadmap-app.desktop"
      },
      "rpm": {
        "depends": [
          "yt-dlp",
          "bubblewrap",
          "bash",
          "ca-certificates"
        ],
        "desktopTemplate": "roadmap-app.desktop"
      }
    }
  }
}
